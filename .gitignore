.DS_Store
.claude/settings.local.json

# Claude Code runtime state (written by hooks each session).
# Ignore the WHOLE directory and re-include only the two tracked files. This used to be a
# hand-listed set of ~30 names, and it failed the way hand-maintained lists fail: it carried
# `subagent-depth` twice and `graph-updates.log` twice, while `subagent-depth-pending.jsonl`
# — the companion queue of an entry already on the list, which _lib.sh requires be handled
# TOGETHER with the counter — was missing entirely and showed up untracked. Nothing in this
# directory is ever committed except .gitkeep and .gitignore (verified: `git ls-files
# .claude/state` returns exactly those two), so a directory rule is both correct and the only
# version that cannot go stale when a hook adds a new state file.
.claude/state/*
!.claude/state/.gitkeep
!.claude/state/.gitignore
# Leaks by design (see agent-start-log.sh) and is session-scoped — committing it
# ships a stale count that silently disables guard-pipeline-direct-work.sh in
# every clone until the first SessionStart resets it.

# Knowledge graph (generated, but graph.json IS committed — see CLAUDE.md
# "scenes/prefabs/graph generated and committed together"; graph-tests CI
# hard-requires graph.json via verify-graphify.sh check_prerequisites, exit 2 if missing)
.claude/graph/graph.json.bak
.claude/graph/*.tmp
.claude/graph/cache/*
!.claude/graph/cache/.gitkeep
.claude/graph/.last-build
.claude/graph/graph.html

# Python bytecode
__pycache__/
*.pyc
*.pyo
