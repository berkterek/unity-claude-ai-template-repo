{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-gate-cleared.sh",
            "timeout": 3000,
            "statusMessage": "Checking Director Gate..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/gateguard.sh",
            "timeout": 5000,
            "statusMessage": "Gate guard: checking read history..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-git-push.sh",
            "timeout": 3000,
            "statusMessage": "Checking for git push..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-scene-edit.sh",
            "timeout": 3000,
            "statusMessage": "Checking for scene/prefab edits..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-editor-runtime.sh",
            "timeout": 5000,
            "statusMessage": "Checking UnityEditor guard..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-pure-csharp.sh",
            "timeout": 5000,
            "statusMessage": "Checking pure C# constraint..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-input-system.sh",
            "timeout": 5000,
            "statusMessage": "Checking Input System patterns..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-vcontainer-singleton.sh",
            "timeout": 5000,
            "statusMessage": "Checking for singleton patterns..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-critical-files.sh",
            "timeout": 5000,
            "statusMessage": "Checking critical architecture files..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-unity-event.sh",
            "timeout": 5000,
            "statusMessage": "Checking UnityEvent usage..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-time-scale.sh",
            "timeout": 5000,
            "statusMessage": "Checking Time.timeScale assignment..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-enum-byte-base.sh",
            "timeout": 5000,
            "statusMessage": "Checking enum byte base in ECS/IEvent..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-config-protection.sh",
            "timeout": 5000,
            "statusMessage": "Checking config file protection..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-reviewer-order.sh",
            "timeout": 3000,
            "statusMessage": "Checking reviewer order (Codex first)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-no-linq-hotpath.sh",
            "timeout": 5000,
            "statusMessage": "Checking LINQ on hot paths..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-no-hotpath-expensive-calls.sh",
            "timeout": 5000,
            "statusMessage": "Checking expensive calls on hot paths..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-getcomponent-in-awake.sh",
            "timeout": 5000,
            "statusMessage": "Checking GetComponent in Awake..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-no-runtime-instantiate.sh",
            "timeout": 5000,
            "statusMessage": "Checking runtime instantiation..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/warn-serialization.sh",
            "timeout": 5000,
            "statusMessage": "Checking serialization safety..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-ecs-structural-changes.sh",
            "timeout": 3000,
            "statusMessage": "Checking ECS structural changes..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-async-void.sh",
            "timeout": 5000,
            "statusMessage": "Checking async void usage..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-unitask-cancellation.sh",
            "timeout": 5000,
            "statusMessage": "Checking UniTask cancellation tokens..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-null-propagation.sh",
            "timeout": 5000,
            "statusMessage": "Checking null propagation on Unity objects..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-vcontainer-singleton.sh",
            "timeout": 5000,
            "statusMessage": "Checking for singleton patterns..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/instinct-capture.sh",
            "timeout": 3000,
            "statusMessage": "Capturing instinct..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cost-tracker.sh",
            "timeout": 2000,
            "statusMessage": "Tracking cost..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/track-codex-review.sh",
            "timeout": 3000,
            "statusMessage": "Tracking Codex review completion..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-restore.sh",
            "timeout": 3000,
            "statusMessage": "Restoring session state..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/instinct-distill.sh",
            "timeout": 10000,
            "statusMessage": "Distilling instincts..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-save.sh",
            "timeout": 3000,
            "statusMessage": "Saving session state..."
          }
        ]
      }
    ]
  },
  "env": {
    "UNITY_HOOK_PROFILE": "strict"
  }
}
