{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unity-claude-template/graph/schema.json",
  "title": "UnityKnowledgeGraph",
  "description": "Graphify-inspired knowledge graph for Unity projects. Generated by graph-builder.py \u2014 do not edit by hand. v1.3.0 \u2014 codebase.scenes and codebase.prefabs are now partitioned to sibling files (scenes.json, prefabs.json) via {\"$partition\": \"<filename>\"} references; legacy inline arrays still accepted via oneOf.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "codebase"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver. Increment minor on additive changes, major on breaking changes."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 UTC timestamp of the last successful build."
    },
    "generator": {
      "type": "string",
      "description": "graph-builder.py@<git-sha>"
    },
    "extraction_version": {
      "type": "integer",
      "description": "graph-builder.py's EXTRACTION_VERSION constant at build time. Bumped only when extraction SEMANTICS change (same input file now produces a different record) \u2014 distinct from schema_version, which tracks document SHAPE. Read back by the builder on --incremental runs: a stored value that differs from (or is absent from) the current EXTRACTION_VERSION promotes that run to --full once, self-clearing on write."
    },
    "confidence_legend": {
      "type": "object",
      "properties": {
        "EXTRACTED": {
          "type": "string"
        },
        "INFERRED": {
          "type": "string"
        },
        "AMBIGUOUS": {
          "type": "string"
        }
      }
    },
    "codebase": {
      "$ref": "#/definitions/codebase"
    },
    "analysis": {
      "$ref": "#/definitions/analysisBlock"
    },
    "validation": {
      "$ref": "#/definitions/validation"
    },
    "stats": {
      "$ref": "#/definitions/stats"
    }
  },
  "definitions": {
    "codebase": {
      "type": "object",
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/classEntry"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/interfaceEntry"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eventEntry"
          }
        },
        "vcontainer": {
          "$ref": "#/definitions/vcontainerGraph"
        },
        "assemblies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/assemblyEntry"
          }
        },
        "scenes": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/sceneEntry"
              },
              "description": "Inline array (legacy, pre-v1.3.0)."
            },
            {
              "type": "object",
              "required": [
                "$partition"
              ],
              "properties": {
                "$partition": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "description": "Partition reference (v1.3.0+)."
            }
          ]
        },
        "prefabs": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/prefabEntry"
              },
              "description": "Inline array (legacy, pre-v1.3.0)."
            },
            {
              "type": "object",
              "required": [
                "$partition"
              ],
              "properties": {
                "$partition": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "description": "Partition reference (v1.3.0+)."
            }
          ]
        },
        "mcp_extraction": {
          "$ref": "#/definitions/mcpExtractionMeta"
        },
        "calls": {
          "type": "array",
          "description": "Call edges between methods. Top-level so traversal is O(edges) without scanning classes[].",
          "items": {
            "$ref": "#/definitions/callEdge"
          }
        },
        "communities": {
          "type": "array",
          "description": "Class community groups produced by graph_cluster.py. Optional \u2014 absent on graphs with no call edges.",
          "items": {
            "$ref": "#/definitions/communityEntry"
          }
        }
      }
    },
    "classEntry": {
      "type": "object",
      "required": [
        "name",
        "file",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "description": "Relative path from project root."
        },
        "source_file": {
          "type": "string",
          "description": "Same as file \u2014 used as SHA256 cache merge key."
        },
        "line": {
          "type": "integer"
        },
        "base_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Raw base list from parser (class + interface names)."
        },
        "is_mono_behaviour": {
          "type": "boolean"
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Constructor-injected types."
        },
        "events_published": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events_subscribed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_static_instance": {
          "type": "boolean",
          "description": "True if class has Instance/Current/Shared/Main/Default static property or _instance static field."
        },
        "methods": {
          "type": "array",
          "description": "Methods declared on this class. Optional \u2014 populated by csharp-extractor.sh from v1.1.0+.",
          "items": {
            "$ref": "#/definitions/methodEntry"
          }
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "interfaceEntry": {
      "type": "object",
      "required": [
        "name",
        "file",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "implementers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "eventEntry": {
      "type": "object",
      "required": [
        "name",
        "file",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "publishers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subscribers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace of the declaring IEvent struct. Empty when no declaration record was extracted."
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "description": "1-based line of the IEvent struct declaration. null when no declaration record was extracted."
        },
        "declaration_unresolved": {
          "type": "boolean",
          "description": "True when this event is only known from a Publish/Subscribe reference and no IEvent struct declaration was extracted. file/source_file are then EMPTY on purpose \u2014 they are never backfilled from the referencing class, which is what previously made every event's location confidently wrong."
        }
      }
    },
    "vcontainerGraph": {
      "type": "object",
      "properties": {
        "installers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/installerEntry"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scopeEntry"
          }
        }
      }
    },
    "installerEntry": {
      "type": "object",
      "required": [
        "name",
        "file"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "registrations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registrationEntry"
          }
        }
      }
    },
    "scopeEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short type name of the parent LifetimeScope, or null when unresolved. null is NOT proof of absence \u2014 read parent_unresolved_reason."
        },
        "installers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent_source": {
          "enum": [
            "code",
            "inspector"
          ],
          "description": "Which route resolved parent. 'code' = ParentReference.Create<T>() in Awake() (csharp_extractor.py). 'inspector' = serialized parentReference.TypeName on the prefab (MCP Step 2b). Code wins on conflict: Create<T>() overwrites the struct at runtime."
        },
        "parent_unresolved_reason": {
          "enum": [
            "no-parent-declared",
            "mcp-extraction-absent"
          ],
          "description": "Present only when parent is null. 'mcp-extraction-absent' = the Inspector route was never read (Unity not connected). 'no-parent-declared' = both routes were read and neither named a parent; ambiguous by nature \u2014 fits a real root scope AND a parent assigned indirectly."
        },
        "registrations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registrationEntry"
          }
        }
      }
    },
    "assemblyEntry": {
      "type": "object",
      "required": [
        "name",
        "file",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "allowUnsafeCode": {
          "type": "boolean"
        },
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "sceneEntry": {
      "type": "object",
      "required": [
        "name",
        "path",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_file": {
          "type": "string",
          "description": "Same as path \u2014 cache key."
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "gameobjects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gameObjectEntry"
          }
        }
      }
    },
    "gameObjectEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gameObjectEntry"
          }
        }
      }
    },
    "prefabEntry": {
      "type": "object",
      "required": [
        "name",
        "path",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "description": "UI|VFX|Enemies|Environment|Audio|Characters|Bootstrap|CoreObjects|ThirdParty"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isVariant": {
          "type": "boolean"
        },
        "basePrefab": {
          "type": "string"
        }
      }
    },
    "mcpExtractionMeta": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "skipped",
            "error"
          ]
        },
        "skipped_reason": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/validationFinding"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/validationFinding"
          }
        },
        "accuracy": {
          "$ref": "#/definitions/accuracyReport"
        }
      }
    },
    "validationFinding": {
      "type": "object",
      "required": [
        "rule_id",
        "message",
        "severity"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "scanned_files": {
          "type": "integer"
        },
        "cache_hits": {
          "type": "integer"
        },
        "build_ms": {
          "type": "integer"
        }
      }
    },
    "methodEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "Full signature minus body, e.g. 'public async UniTask Foo(int x)'."
        },
        "line": {
          "type": "integer"
        },
        "accessibility": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "protected"
          ]
        },
        "is_async": {
          "type": "boolean"
        },
        "is_static": {
          "type": "boolean"
        },
        "return_type": {
          "type": "string"
        }
      }
    },
    "callEdge": {
      "type": "object",
      "required": [
        "caller",
        "callee",
        "confidence"
      ],
      "properties": {
        "caller": {
          "type": "string",
          "description": "Qualified caller \u2014 'ClassName.MethodName' or 'Namespace.ClassName.MethodName'."
        },
        "callee": {
          "type": "string",
          "description": "Qualified callee \u2014 same format. May be unqualified for INFERRED edges."
        },
        "file": {
          "type": "string",
          "description": "Source file containing the call site."
        },
        "line": {
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "caller_file": {
          "type": "string",
          "description": "File containing the caller (== call-site file)."
        },
        "callee_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Resolved file of callee's declaring type; null when external/unresolved."
        },
        "callee_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "Resolved project type owning the callee method; null when unresolved."
        },
        "method_match": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "REV5: true if callee method is in the resolved type's methods[]; false if populated but absent; null if methods[] empty/unknown. Recomputed every build; independent of confidence."
        },
        "callee_kind": {
          "type": "string",
          "enum": [
            "internal",
            "external",
            "unresolved"
          ],
          "description": "Lever 0: internal = linked to a project type; external = resolved non-project type (Unity/BCL/3rd-party) \u2014 a correct null; unresolved = bare variable head or ambiguous same-name type \u2014 the genuine miss."
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "EXTRACTED",
        "INFERRED",
        "AMBIGUOUS"
      ]
    },
    "communityEntry": {
      "type": "object",
      "required": [
        "id",
        "members"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "integer"
        },
        "modularity": {
          "type": "number"
        },
        "scope": {
          "type": "string"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "greedy-modularity-stdlib",
            "louvain-networkx"
          ]
        }
      }
    },
    "analysisBlock": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "surprising_connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/surprisingConnection"
          }
        },
        "enhanced_god_nodes": {
          "type": "array"
        }
      }
    },
    "surprisingConnection": {
      "type": "object",
      "required": [
        "caller",
        "callee",
        "reason"
      ],
      "properties": {
        "caller": {
          "type": "string"
        },
        "callee": {
          "type": "string"
        },
        "caller_community": {
          "type": "integer"
        },
        "callee_community": {
          "type": "integer"
        },
        "caller_scope": {
          "type": "string"
        },
        "callee_scope": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "CROSS_COMMUNITY",
            "CROSS_SCOPE",
            "CROSS_ASSEMBLY"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning"
          ]
        }
      }
    },
    "accuracyReport": {
      "type": "object",
      "properties": {
        "sampled_classes": {
          "type": "integer"
        },
        "matches": {
          "type": "integer"
        },
        "mismatches": {
          "type": "integer"
        },
        "agreement_pct": {
          "type": "number"
        },
        "checks": {
          "type": "array"
        },
        "low_accuracy_warning": {
          "type": "boolean"
        },
        "warning_message": {
          "type": "string"
        }
      }
    },
    "registrationEntry": {
      "type": "object",
      "description": "One builder.Register* call. Shared by installerEntry and scopeEntry \u2014 scopes carry registrations too (GameScope's RegisterComponent calls), which this schema previously did not declare at all.",
      "properties": {
        "type": {
          "type": "string",
          "description": "Concrete type registered. Empty when the argument was opaque (e.g. RegisterComponent(_field)); see `unresolved`."
        },
        "as": {
          "type": "string",
          "description": "Exposed service from the trailing chain. Either an interface name from .As<T>(), or the LITERAL string \"AsImplementedInterfaces\" \u2014 that call names no type, so it is a placeholder, not an interface name. Match `as_resolved` to find what it actually registers."
        },
        "as_resolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Interfaces an AsImplementedInterfaces() registration actually exposes, resolved from the concrete type's own + inherited `implements`. Present only when `as` is the placeholder. Read `as_resolution` before treating it as exhaustive."
        },
        "as_resolution": {
          "enum": [
            "full",
            "partial"
          ],
          "description": "full = a concrete type was named and its whole base chain was walkable. partial = the list is incomplete; see as_resolution_reason. Never absent when as_resolved is present."
        },
        "as_resolution_reason": {
          "enum": [
            "type-unresolved",
            "class-not-in-graph",
            "base-not-in-graph"
          ],
          "description": "Present only when as_resolution is partial. type-unresolved = no concrete type to look up. class-not-in-graph = the concrete type is not in classes[] (third-party/generated, or an extraction miss). base-not-in-graph = the base chain left the graph, so interfaces on an unseen ancestor are missing."
        },
        "lifetime": {
          "type": "string",
          "enum": [
            "Singleton",
            "Scoped",
            "Transient",
            ""
          ],
          "description": "ALWAYS the empty string today \u2014 csharp_extractor.py hardcodes \"\" in every registration branch and never reads the Lifetime argument, so `Register<T>(Lifetime.Singleton)` records \"\" just like RegisterComponent does. The three named values are reserved for when extraction populates it; until then do NOT present this field as the registered lifetime, and do not infer Transient from an empty value. Adding \"\" to the enum documents the actual output rather than leaving the schema asserting values that are never produced."
        },
        "scope": {
          "type": "string"
        },
        "unresolved": {
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    }
  }
}
